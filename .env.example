# Crie a chave no NVIDIA Build: https://build.nvidia.com/
# A chave deve ficar SOMENTE aqui no backend.
NVIDIA_API_KEY=
# auto: descobre e testa modelos de chat com endpoint de avaliação gratuita.
# Mesmo que você use um ID manualmente, o servidor tentará alternativas caso falhe.
NVIDIA_MODEL=auto
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
PORT=8787
